# Copy to .env and fill in the values. Never commit .env.

# Required for generated answers. The chatbot still returns retrieved records
# without this key, and it will say the language model is unavailable.
OPENROUTER_API_KEY=

# Optional. Leave blank to select the first available free model at startup.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=

OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=EstateIQ

# Required for scrape and index endpoints. Use a long random string.
ADMIN_TOKEN=

# Contact address sent with scraper requests.
CONTACT_EMAIL=

DATA_DIR=./data
RETRIEVAL_THRESHOLD=0.35
RETRIEVAL_TOP_K=6
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Public deployment should keep scraping off and use a prebuilt index.
SCRAPER_ENABLED=true
AUTO_INDEX_ON_START=false

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
HOST=0.0.0.0
PORT=8000
